# 動画ナビ キャッシュ制御
#
# 背景: エックスサーバーの既定では .js / .html に Cache-Control: max-age=604800
# (7日キャッシュ) が付くため、videos.js を毎日更新しても訪問者のブラウザが
# 最大7日間 古いデータを表示し続ける（要約・カテゴリが反映されない）。
#
# 対策: HTML と JS は「キャッシュしてよいが毎回サーバーに最新か確認する」
# (no-cache) に変更。中身が変わっていなければ 304 で軽く済み、
# 変わっていればその場で最新が反映される。
# 画像(png)や css は変更頻度が低いので既定のキャッシュのまま。

<IfModule mod_headers.c>
  <FilesMatch "\.(html|js)$">
    Header set Cache-Control "no-cache, must-revalidate"
    Header unset Expires
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 0 seconds"
  ExpiresByType text/javascript "access plus 0 seconds"
</IfModule>
