# 動画ナビ キャッシュ制御
#
# ⚠️ 重要: エックスサーバーは nginx が静的ファイル(.js/.css/画像)を直接配信し、
# その際 nginx は .htaccess を読まない。よって下記の Header/Expires 指定は
# videos.js 等には効かない（検証済み: max-age=604800 のまま）。
# 実際のキャッシュ対策は index.html の ?v= を videos.js 更新時に書き換える方式で
# 行っている（scripts/run_daily_local.sh）。この .htaccess は Apache が処理する
# ケースのための保険として残している。
#
# 背景: nginx 既定で .js に Cache-Control: max-age=604800 (7日) が付くため、
# videos.js を毎日更新しても、URL(?v=)を変えない限り訪問者のブラウザは
# 最大7日間 古いデータを表示し続ける（要約・カテゴリが反映されない）。

<IfModule mod_headers.c>
  <FilesMatch "\.(html|js)$">
    Header set Cache-Control "no-cache, must-revalidate"
    Header unset Expires
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 0 seconds"
  ExpiresByType text/javascript "access plus 0 seconds"
</IfModule>
